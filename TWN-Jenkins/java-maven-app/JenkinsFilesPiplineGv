pipeline {   
    agent any
    parameters {
        string(name: 'VERSION', defaultValue: '', description: 'version to deploy on prod')
        choice(name: 'VERSION', ['1.1.0', '1.2.0', '1,3.0'], description:'')
        booleanParam(name: 'execteTests', defaultValue: true, description:'')
    }
    stages {
        stage("build") {
            steps {
                script{
                    gv.buildApp()
                }
            }
        }
        stage("test") {
            when {
                expression {
                    params.executeTests
                } 
            }
            steps{
                script{
                    gv.testApp()
                }
            }
        }
        stage("deploy") {
            steps {
                echo 'deploying the application...'                 
            }
        }
    }               
} 